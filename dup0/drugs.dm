/turf/proc/wall_melt(mob/M)















































































































































































































































































































































































































































































































	var/D = new /obj/drugged(src.loc)
	D:icon = 'grafon/thingy.dmi'
	D:icon_state = "wall_melt"
	var/Imelt = image(D:icon, src, D:icon_state, D:layer)
	Imelt:loc = src
	M << Imelt
	spawn(34)
		del(D)
		spawn(0) del(Imelt)
