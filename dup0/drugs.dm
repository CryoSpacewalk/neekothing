// Recovered from compiled neek.dmb (45 procs)

/proc/omsk_gen()





	for(var/obj/landmark/wall/W in world)
		if(prob(50))
			new /turf/rock(W.loc)
	for(var/obj/landmark/omich/O in world)
		if(prob(75))
			new /obj/omich(O.loc)
	spawn(0)
		for(var/turf/ground/T in locate(/area/light/omsko))
			spawn(0)
				if(prob(10))
					new /turf/ground/grass(T)
				else if(prob(13))
					new /turf/ground/asphalt(T)

/mob/proc/speedcheck()













	var/required_speed = 1

	if(src.euphoria < 0)
		required_speed = max(-3, round(src.euphoria / 10))

	if(src.hunger < 15)
		required_speed = -3

	if(src.blood_chem:len)

		for(var/datum/reagent/R in src.blood_chem)
			for(var/speedname in stim_list)
				if(R.id == speedname)
					required_speed = max(required_speed, stim_list[speedname])

	spawn(0) src:mov_speed = required_speed

/obj/landmark/wall
	name = "omsko wall"
	icon_state = "omsk"

/obj/landmark/wall

