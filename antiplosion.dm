// Recovered from compiled neek.dmb (1 procs)
/obj/proc/antiplosion(radius)
	src.playsound(pick('sounds/explosion1.ogg', 'sounds/explosion1.ogg'))
	for(var/obj/structure/container/C in range(radius * 4, loc))
		if(C.opened == 0)
			C.welded = 0
			C.opclose()
	spawn(0)
		for(var/mob/M in range(radius * 2, src.loc))
			if(M.dead == 0)
				M.damaga(radius * 2, "brute", 1)
			else if(M.mat == "flesh" && radius >= 1)
				M.gib()
		spawn(0)
			for(var/mob/M in range(radius * 4, src.loc))
				if(M.dead == 0)
					M.damaga(round(radius * 1.5), "organ")
	for(var/obj/structure/reinforcement/R in range(radius, src.loc))
		R.damage(5)
	for(var/obj/structure/reinforcement/R in range(radius * 2, src.loc))
		R.damage(3)
	for(var/obj/structure/reinforcement/R in range(radius * 4, src.loc))
		R.damage(1)
	for(var/obj/structure/window/W in range(radius, src.loc))
		W.damage(25)
	for(var/obj/structure/window/W in range(radius * 4, src.loc))
		W.damage(5)
	for(var/obj/beacon/C in range(radius, src.loc))
		C.damage(50)
	for(var/obj/bio/weed/W in range(radius, src.loc))
		W.grassdmg(9000)
	for(var/obj/bio/cucumber/CU in range(radius, src.loc))
		CU.attack_hand()
	for(var/obj/bio/tick_swarm/T in range(radius, src.loc))
		src.hide(T)
	for(var/obj/bio/bumblebee/B in range(radius, src.loc))
		B.bee_damage(radius * 5)
	for(var/obj/bio/amoeba/AE in range(radius, src.loc))
		AE.biodmg(20)
	for(var/obj/bio/amoeba/AE in range(radius * 3, src.loc))
		spawn(0)
			if(AE)
				AE.biodmg(radius * 10)
	for(var/obj/putin/AE in range(radius, src.loc))
		AE.biodmg(20)
	for(var/obj/putin_big/AE in range(radius, src.loc))
		AE.biodmg(20)
		if(prob(33))
			src.show_message("\blue \bold Looks like [AE.name] is stunned!")
			AE.hybernation()
	for(var/obj/putin/AE in range(radius * 3, src.loc))
		spawn(0)
			if(AE)
				AE.biodmg(radius * 10)
	for(var/obj/door/D in range(radius, src.loc))
		if(prob(33 + radius * 2))
			D.fuckup()
	for(var/obj/door/D in range(round(radius * 1.5), src.loc))
		if(!(D.material == "STEEL") && prob(5))
			D.fuckup()
	for(var/turf/ice/I in range(radius, src.loc))
		I.digout()
	for(var/obj/machine/turret/T in range(radius, src.loc))
		if(T.dying == 0)
			for(var/i = 0, i < 5, i++)
				new /obj/item/debris/machine(locate(T.x + pick(1, 0, -1), T.y + pick(1, 0, -1), T.z))
			T.dying = 1
			if(prob(50))
				for(var/mob/M in hearers(T))
					if(!M.sleeps)
						M << "\red Boom!"
				T.explosion(0.5)
	var/TF = get_turf(src)
	for(var/atom/A in orange(radius + 2, TF))
		if(isturf(A) || A.anchored)
			continue
		if(A)
			var/O = src
			var/distance = max(x - A.x, y - A.y)
			src = null
			spawn(0)

				A.throw_at(TF, (radius - distance + 1) * 3)
			src = O
