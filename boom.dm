// Recovered from compiled neek.dmb (1 procs)
/atom/proc/explosion(radius)
	src.playsound(pick('sounds/explosion1.ogg', 'sounds/explosion1.ogg'))
	for(var/obj/structure/container/C in range(radius * 4, loc))
		if(C.opened == 0)
			C.welded = 0
			C.opclose()
	for(var/turf/T in range(radius, src.loc))
		if(prob(90) && T.bombable)
			T.spacize()
	for(var/turf/wall/W in range(radius * 2, src.loc))
		if(prob(80) && W.removable)
			W.remove()
	for(var/turf/floor/F in range(radius * 2, src.loc))
		if(prob(10) && F.bombable)
			F.spacize()
	for(var/mob/M in range(radius, src.loc))
		if(M.dead == 0)
			M.damaga(radius * 30, "burn")
	spawn(0)
		for(var/mob/M in range(1 + radius * 2, src.loc))
			if(M.dead == 0)
				M.damaga(radius * 20, "brute")
			else if(M.mat == "flesh")
				M.gib()
		spawn(0)
			for(var/mob/M in range(1 + radius * 4, src.loc))
				if(M.dead == 0)
					M.damaga((1 + radius) * 5, "organ", 1)
				else if(M.mat == "flesh" && radius >= 1)
					M.gib()
			spawn(0)
				for(var/mob/M in range(1 + radius * 3.5, src.loc))
					if(M.dead == 0)
						M.damaga((1 + radius) * 10, "brute", 1)
					else if(M.mat == "flesh" && radius >= 1)
						M.gib()
	for(var/obj/structure/reinforcement/R in range(radius, src.loc))
		R.damage(30)
	for(var/obj/structure/reinforcement/R in range(radius * 2, src.loc))
		R.damage(20)
	for(var/obj/structure/reinforcement/R in range(radius * 4, src.loc))
		R.damage(10)
	for(var/obj/O in range(radius, src.loc))
		if(prob(100 - O.bomb_proof))
			spawn(0) del(O)
	for(var/obj/structure/window/W in range(radius * 4, src.loc))
		W.damage(30)
	for(var/obj/beacon/C in range(radius * 2, src.loc))
		C.damage(50)
	for(var/obj/bio/weed/W in range(radius * 2, src.loc))
		W.grassdmg(9000)
	for(var/obj/bio/cucumber/CU in range(radius * 2.5, src.loc))
		CU.attack_hand()
	for(var/obj/bio/tick_swarm/T in range(radius, src.loc))
		del(T)
	for(var/obj/bio/bumblebee/B in range(radius, src.loc))
		B.bee_damage(radius * 10)
	for(var/obj/bio/amoeba/AE in range(radius, src.loc))
		AE.biodmg(50)
	for(var/obj/bio/amoeba/AE in range(radius * 3, src.loc))
		spawn(0)
			if(AE)
				AE.biodmg(radius * 20)
	for(var/obj/putin/AE in range(radius, src.loc))
		AE.biodmg(20)
	for(var/obj/putin/AE in range(radius * 3, src.loc))
		spawn(0)
			if(AE)
				AE.biodmg(radius * 10)
	for(var/obj/putin_big/AE in range(radius, src.loc))
		AE.biodmg(radius * 10)
	for(var/obj/putin_big/AE in range(radius, src.loc))
		AE.biodmg(50)
		if(prob(33) && (AE && !AE.deleted))
			src.show_message("\blue \bold Looks like [AE.name] is stunned!")
			AE.hybernation()
	for(var/obj/door/D in range(radius, src.loc))
		D.fuckup()
	for(var/obj/door/D in range(radius * 2, src.loc))
		if(!(D.material == "STEEL"))
			D.fuckup()
		else
			new /obj/item/material/sheet(D.loc)
			D.melt_o = new /obj/overlay/doormelt()
			if(D.closed)
				D.overlays += D.melt_o
	for(var/obj/machine/gas/pipealike/PA in range(radius * 2, src.loc))
		if(prob(50))
			PA.deconstruct(PA.product)
		else if(prob(50))
			PA.release()
			del(PA)
	for(var/obj/wire/W in range(radius * 2, src.loc))
		if(prob(20))
			var/CB = new /obj/item/cable(W.loc)
			CB:cminus(9)
			if(istype(W, /obj/wire/battery))
				if(prob(25))
					new /obj/item/outlet(W.loc)
			del(W)
		else if(prob(75))
			new /obj/melt(W.loc)
			del(W)
	for(var/obj/triwire/W in range(radius * 2, src.loc))
		if(prob(20))
			new /obj/item/tbranch(src.loc)
			var/CB = new /obj/item/cable(W.loc)
			CB:cminus(9)
			del(W)
		else if(prob(75))
			new /obj/melt(W.loc)
			spawn(0) del(W)
	for(var/turf/ice/I in range(radius, src.loc))
		I.digout()
	for(var/turf/ice/I in range(radius * 2, src.loc))
		if(prob(20))
			I.digout()
	for(var/obj/machine/turret/T in range(radius, src.loc))
		if(T.dying == 0)
			for(var/i = 0, i < 5, i++)
				new /obj/item/debris/machine(locate(T.x + pick(1, 0, -1), T.y + pick(1, 0, -1), T.z))
			T.dying = 1
			if(prob(50))
				for(var/mob/M in hearers(T))
					if(!M.sleeps)
						M << "\red Boom!"
				T.explosion(0.5)
	for(var/atom/A in orange(radius + 2, get_turf(src)))
		if(isturf(A) || A.anchored)
			continue
		if(A)
			var/t = get_turf(A)
			var/distance = max(src.x - A.x, src.y - A.y)
			for(var/i = 0, i < radius - distance + 2, i++)
				t = get_step_away(t, src, 100)
			var/O = src
			src = null
			spawn(0)

				A.throw_at(t, (radius - distance + 1) * 3)
			src = O
