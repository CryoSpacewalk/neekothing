{
    // On main the source files are UTF-8 (converted from the original Windows-1251).
    // The bitperfect branch keeps the original Windows-1251 files and settings.
    "files.encoding": "utf8",
    "files.autoGuessEncoding": false,
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "editor.insertSpaces": false
}
